# Kabadiwala Backend — copy to .env and edit
APP_NAME=Kabadiwala API
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# sqlite:///./data/kabadiwala.db  OR  postgresql+psycopg2://user:pass@localhost:5432/kabadiwala
DATABASE_URL=sqlite:///./data/kabadiwala.db

# Comma-separated origins, or * for prototype
CORS_ORIGINS=*

API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Seed demo users on first boot
SEED_ON_STARTUP=true

# Matching weights (must sum ~ 1.0)
MATCH_W_DISTANCE=0.40
MATCH_W_PRICE=0.30
MATCH_W_AVAILABILITY=0.15
MATCH_W_KARMA=0.15
MATCH_TOP_N=3
MATCH_MAX_DISTANCE_KM=150
